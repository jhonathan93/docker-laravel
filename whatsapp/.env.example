# Redis (mesma rede do docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# Webhook do Laravel (host 'app' na rede interna)
LARAVEL_WEBHOOK_URL=http://app/api/whatsapp/webhook
WEBHOOK_SECRET=troque-este-segredo

# Fila de saída (Laravel -> gateway) e diretório da sessão
WA_OUTBOUND_KEY=wa:outbound
AUTH_DIR=/app/auth

LOG_LEVEL=info

# Ritmo de envio (anti-ban): gap entre mensagens, proporcional ao tamanho do
# texto, sempre dentro de [min, max] + jitter. Durante o gap mostra "digitando...".
WA_SEND_GAP_MIN_MS=3000
WA_SEND_GAP_MAX_MS=8000
WA_SEND_CHAR_SATURATION=280
WA_SEND_JITTER_MS=1500
WA_TYPING_INDICATOR=true

# Servidor HTTP de status/health/qr
HTTP_PORT=3000

# Idempotência de entrada (TTL em segundos do "já visto")
WA_DEDUPE_TTL=3600

# Saída: retry + dead-letter
WA_DEADLETTER_KEY=wa:outbound:dead
WA_MAX_SEND_ATTEMPTS=3
WA_RETRY_BASE_MS=2000

# Reconexão: backoff exponencial
WA_RECONNECT_BASE_MS=3000
WA_RECONNECT_MAX_MS=60000

# MinIO (S3) — mesmo bucket do Laravel; mídia recebida/enviada
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=laravel
WA_MEDIA_PREFIX=whatsapp

# Validação/normalização de destinatário (onWhatsApp) + cache do JID
WA_VALIDATE_RECIPIENT=true
WA_JID_CACHE_TTL=604800
WA_JID_NEG_TTL=86400

# History sync no pareamento: false = só o recente; true = histórico completo (volume alto)
WA_SYNC_FULL_HISTORY=false
